    "Erscheinungsbild": {
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Appearance" } } }
    },
    "„Automatisch“ folgt der Einstellung deines iPhones und wechselt mit ihr zwischen Hell und Dunkel. Hell und Dunkel gelten dauerhaft, egal was das iPhone vorgibt.": {
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "“Automatic” follows your iPhone’s setting and switches between Light and Dark with it. Light and Dark always apply, whatever your iPhone is set to." } } }
    },
