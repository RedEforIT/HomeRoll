    "Automatisch": {
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Automatic" } } }
    },
    "Hell": {
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Light" } } }
    },
